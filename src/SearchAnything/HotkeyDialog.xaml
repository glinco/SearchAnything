<Window x:Class="SearchAnything.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SearchAnything - Change shortcut"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="True">
    <StackPanel Margin="20" Width="340">
        <TextBlock Text="Press the new shortcut. Include Ctrl, Alt or Win." TextWrapping="Wrap"/>
        <Border Margin="0,12,0,0" Padding="10" BorderBrush="#40000000" BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="Display" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="Error" Foreground="#C62828" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="80" IsEnabled="False" Click="OnSave"/>
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
