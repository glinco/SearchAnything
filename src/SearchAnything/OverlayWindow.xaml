<Window x:Class="SearchAnything.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SearchAnything"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="0" Top="0" Width="800" Height="600"
        Background="Black" UseLayoutRounding="True">
    <Grid>
        <!-- The frozen screenshot, drawn 1:1 in physical pixels; highlights use the same pixel coordinates. -->
        <Viewbox Stretch="Fill">
            <Grid x:Name="Surface">
                <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                       MouseLeftButtonDown="OnBackgroundClick"/>
                <Path x:Name="Dim" Fill="Black" Opacity="0.25" IsHitTestVisible="False"/>
                <Canvas x:Name="Marks"/>
            </Grid>
        </Viewbox>

        <Border x:Name="Panel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,28"
                Background="#F2202024" BorderBrush="#33FFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="14,10,14,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel x:Name="Bar" Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Foreground="#FFBE00" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Grid Width="380">
                        <TextBlock x:Name="Placeholder" Text="Find on screen…" FontSize="18" Foreground="#77FFFFFF"
                                   VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" FontSize="18" Foreground="White" CaretBrush="White"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 SelectionBrush="#FFBE00" TextChanged="OnQueryChanged"/>
                    </Grid>
                    <TextBlock x:Name="Status" FontSize="14" Foreground="#AAFFFFFF" VerticalAlignment="Center"
                               TextAlignment="Right" MinWidth="110" Margin="12,0,0,0"/>
                    <!-- Shown when nothing on screen matches: the same query, searched across installed programs. -->
                    <Button x:Name="ProgramsButton" Visibility="Collapsed" Focusable="False" Cursor="Hand"
                            Margin="10,0,0,0" VerticalAlignment="Center" Click="OnProgramsButton"
                            ToolTip="Search programs on this PC's drives">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chip" Background="#26FFBE00" BorderBrush="#66FFBE00" BorderThickness="1"
                                        CornerRadius="6" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Search programs" FontSize="13" Foreground="#FFBE00" VerticalAlignment="Center"/>
                                        <Border Background="#33FFFFFF" CornerRadius="3" Padding="4,0" Margin="8,0,0,0">
                                            <TextBlock Text="Enter" FontSize="10" Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="#4DFFBE00"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <!-- One chip per drive with matches, to narrow the results to one drive. Filled in code. -->
                <WrapPanel x:Name="DriveChips" Visibility="Collapsed" Margin="26,8,0,0"/>
                <!-- Program results, filled in code. As wide as the bar so long paths are trimmed, not widening it. -->
                <StackPanel x:Name="ProgramList" Visibility="Collapsed" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Width="{Binding ActualWidth, ElementName=Bar}"/>
                <TextBlock x:Name="Hint" FontSize="11" Foreground="#88FFFFFF" Margin="26,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
