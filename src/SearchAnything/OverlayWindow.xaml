<Window x:Class="SearchAnything.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SearchAnything"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="0" Top="0" Width="800" Height="600"
        Background="Black" UseLayoutRounding="True">
    <Grid>
        <!-- The frozen screenshot, drawn 1:1 in physical pixels; highlights use the same pixel coordinates. -->
        <Viewbox Stretch="Fill">
            <Grid x:Name="Surface">
                <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                       MouseLeftButtonDown="OnBackgroundClick"/>
                <Path x:Name="Dim" Fill="Black" Opacity="0.25" IsHitTestVisible="False"/>
                <Canvas x:Name="Marks"/>
            </Grid>
        </Viewbox>

        <Border x:Name="Panel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,28"
                Background="#F2202024" BorderBrush="#33FFFFFF" BorderThickness="1"
                CornerRadius="10" Padding="14,10,14,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Foreground="#FFBE00" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Grid Width="380">
                        <TextBlock x:Name="Placeholder" Text="Find on screen…" FontSize="18" Foreground="#77FFFFFF"
                                   VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" FontSize="18" Foreground="White" CaretBrush="White"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 SelectionBrush="#FFBE00" TextChanged="OnQueryChanged"/>
                    </Grid>
                    <TextBlock x:Name="Status" FontSize="14" Foreground="#AAFFFFFF" VerticalAlignment="Center"
                               TextAlignment="Right" MinWidth="110" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="Hint" FontSize="11" Foreground="#88FFFFFF" Margin="26,6,0,0"
                           Text="Enter next · Shift+Enter previous · Ctrl+C copy line · Ctrl+Shift+C copy all · Esc or click to close"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
